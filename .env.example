# ─── Base de datos (Neon) ─────────────────────────────────────────────
DATABASE_URL=postgres://usuario:password@ep-xxx.eu-central-1.aws.neon.tech/npd?sslmode=require

# ─── Auth.js ──────────────────────────────────────────────────────────
AUTH_SECRET=                      # openssl rand -base64 32
APP_URL=https://proyectos.natu.example   # URL pública (enlaces de los emails)
ADMIN_EMAILS=irene@natu.example   # emails que entran como Admin activo al primer login (arranque)

# SSO Microsoft Entra ID (app single-tenant, permisos delegados openid profile email User.Read)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0/
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=   # rechaza tokens de otros tenants

# Solo desarrollo: login sin Entra ID con usuarios demo (ignorado en producción de Vercel)
AUTH_DEV_LOGIN=false

# ─── Microsoft Graph (permisos de aplicación) ─────────────────────────
# Sites.Selected (write solo sobre "Proyectos NPD") + Mail.Send restringido al buzón compartido
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_ID=               # p. ej. natu.sharepoint.com,<guid>,<guid>
SHAREPOINT_LIBRARY_NAME=Proyectos # o SHAREPOINT_DRIVE_ID directamente
MAIL_SENDER=proyectos@natu.example

# Drivers (por defecto se eligen solos: Graph si hay credenciales, local si no)
# STORAGE_DRIVER=sharepoint|local
# MAIL_DRIVER=graph|log|fail      # fail = simula caída de Graph (pruebas de resiliencia)
# LOCAL_STORAGE_DIR=.storage

# ─── Vercel Cron ──────────────────────────────────────────────────────
CRON_SECRET=                      # Vercel lo envía como "Authorization: Bearer <CRON_SECRET>"
