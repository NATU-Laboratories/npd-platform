# ─── Base de datos (Neon) ─────────────────────────────────────────────
DATABASE_URL=postgres://usuario:password@ep-xxx.eu-central-1.aws.neon.tech/npd?sslmode=require

# ─── Auth.js ──────────────────────────────────────────────────────────
AUTH_SECRET=                      # openssl rand -base64 32
APP_URL=https://npd.natulaboratories.es   # URL pública (enlaces de los emails)
ADMIN_EMAILS=irene@natu.example   # emails que entran como Admin activo al primer login (arranque)

# SSO Microsoft Entra ID (app single-tenant, permisos delegados openid profile email User.Read)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=   # rechaza tokens de otros tenants

# Acceso provisional sin Entra ID (pruebas). En local no pide clave y muestra usuarios demo.
# En Vercel solo se activa si además hay AUTH_DEV_PASSWORD (clave compartida). Borrar ambas
# variables cuando Microsoft esté configurado.
AUTH_DEV_LOGIN=false
AUTH_DEV_PASSWORD=

# ─── Microsoft Graph (permisos de aplicación) ─────────────────────────
# Sites.Selected (write solo sobre "Proyectos NPD") + Mail.Send restringido al buzón compartido
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_ID=               # p. ej. natu.sharepoint.com,<guid>,<guid>
SHAREPOINT_LIBRARY_NAME=Proyectos # o SHAREPOINT_DRIVE_ID directamente
MAIL_SENDER=proyectos@natu.example

# ─── Email por la API de Brevo (provisional) ──────────────────────────
BREVO_API_KEY=                    # clave de API (xkeysib-…), SMTP y API → Claves API
MAIL_FROM=                        # remitente verificado o de un dominio autenticado (p. ej. npd@natulaboratories.es)

# ─── Email por SMTP (provisional, p. ej. Gmail) ───────────────────────
# Gmail: verificación en 2 pasos activada + «Contraseña de aplicación» (16 letras).
SMTP_HOST=                        # smtp.gmail.com
SMTP_PORT=465
SMTP_USER=                        # la cuenta de Gmail
SMTP_PASSWORD=                    # contraseña de aplicación (no la contraseña normal)
MAIL_FROM_NAME=NATU · Proyectos NPD
# Modo pruebas: TODOS los emails (también a proveedores) van a estas direcciones, indicando a quién iban
MAIL_REDIRECT_TO=

# Drivers (por defecto se eligen solos: Graph si hay credenciales, local si no)
# STORAGE_DRIVER=sharepoint|db|local   # db = archivos en Postgres (pruebas en Vercel sin SharePoint)
# MAIL_DRIVER=graph|log|fail      # fail = simula caída de Graph (pruebas de resiliencia)
# LOCAL_STORAGE_DIR=.storage

# ─── Vercel Cron ──────────────────────────────────────────────────────
CRON_SECRET=                      # Vercel lo envía como "Authorization: Bearer <CRON_SECRET>"

# Asistente virtual (chat flotante, OpenAI). Sin esta clave el botón no aparece.
OPENAI_API_KEY=
# Opcional: modelo (por defecto gpt-6.1-terra)
OPENAI_MODEL=

# Bot de Microsoft Teams del asistente (Azure Bot, app single-tenant). Ver docs/TEAMS.md.
# Messaging endpoint en Azure: https://<dominio>/api/teams/messages
TEAMS_APP_ID=                     # ID de aplicación (cliente) del bot
TEAMS_APP_PASSWORD=               # secreto de cliente del bot
TEAMS_TENANT_ID=                  # ID del tenant (si se omite, usa AUTH_MICROSOFT_ENTRA_ID_TENANT_ID)
# Voz de Alexia (opcional): modelos de transcripción y de voz, y la voz
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
